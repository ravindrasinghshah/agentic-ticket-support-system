# Local CDK deployment configuration. Copy this file to .env and replace every example value.
# The endpoint is fixed in code to https://cockroachlabs.cloud/mcp.
# Temporary demo configuration: this ignored file contains the service-account API key.
# Production deployments should retrieve both API keys from Secrets Manager instead.

DEPLOYMENT_STAGE=development
COCKROACH_CLOUD_CLUSTER_ID=01234567-89ab-4def-8123-456789abcdef
COCKROACH_CLOUD_MCP_API_KEY=replace-with-your-cockroach-cloud-service-account-api-key
COCKROACH_CLOUD_DATABASE=ticket_support
CORS_ALLOWED_ORIGIN=http://localhost:3000
GROQ_API_KEY=replace-with-your-groq-api-key

# Optional overrides
GROQ_MODEL_ID=openai/gpt-oss-120b
# 0 disables reserved concurrency and uses the account's shared concurrency pool.
SUPERVISOR_RESERVED_CONCURRENCY=0
