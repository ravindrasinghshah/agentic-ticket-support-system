# ─────────────────────────────────────────────────────────────────────────────────────────
#  Agentic Ticket Support System — configuration template
#
#  Copy to .env and replace every REPLACE_ME. `.env` is gitignored; this file is not.
#
#  REPLACE_ME is a sentinel, not a value. Config resolution THROWS if one reaches an AWS or
#  database call, naming the variable and pointing here — a placeholder must never surface as
#  a confusing downstream error.
#
#  Run `pnpm check:config` to see exactly what is still outstanding and where to get it.
#  Every variable below is documented in docs/CONFIGURATION.md; the by-hand steps that
#  produce the values are in docs/PROVISIONING.md.
#
#  This file must list exactly the keys in packages/core/src/manifest.ts — a contract test
#  in tests/gate-1/contract fails the build if they drift apart.
# ─────────────────────────────────────────────────────────────────────────────────────────

# ── AWS account and region ───────────────────────────────────────────── needed at Gate 1 ─
# Must be a region offering BOTH Bedrock model access and AgentCore. `pnpm doctor` confirms.
AWS_REGION=REPLACE_ME
AWS_ACCOUNT_ID=REPLACE_ME
# Optional. Leave unset to use the default AWS credential chain.
# AWS_PROFILE=

# ── Bedrock / AgentCore ──────────────────────────────────────────────────────────────────
# Gate 1. Resolve the exact ID from the live service — never from memory.
#   aws bedrock list-foundation-models --region $AWS_REGION --query "modelSummaries[].modelId"
BEDROCK_SUPERVISOR_MODEL_ID=REPLACE_ME

# Gate 6, and BLOCKING. The embedding model is a user decision, never a default: every vector
# in `resolutions` comes from one model, vectors from different models are not comparable,
# and a later change corrupts similarity search WITHOUT erroring. Leave both as REPLACE_ME
# until the user supplies the model ID, its output dimension, and — if it offers several —
# which dimension to use. The doctor reports SKIPPED until then. (ARCHITECTURE.md §9.2)
EMBEDDING_MODEL_ID=REPLACE_ME
EMBEDDING_DIM=REPLACE_ME

# Gate 2 — created by hand when the supervisor is first deployed.
AGENTCORE_RUNTIME_ARN=REPLACE_ME
AGENTCORE_MEMORY_ID=REPLACE_ME

# Gate 3 — created by hand when the specialists are published as MCP tools.
AGENTCORE_GATEWAY_URL=REPLACE_ME
AGENTCORE_GATEWAY_AUTH_MODE=iam
# AGENTCORE_GATEWAY_AUTH_TOKEN=

# ── CockroachDB ──────────────────────────────────────────────────────── needed at Gate 1 ─
COCKROACH_DATABASE_URL=REPLACE_ME
# Absolute path to cc-ca.crt. Keep it outside the repo, or under certs/ which is gitignored.
COCKROACH_SSL_ROOT_CERT=REPLACE_ME

# Which TicketDataPort implementation the agent side uses. Stays `sql` unless Gate 1's
# cockroachdb-mcp-connector check proves MCP auth works from this environment.
DB_ACCESS_MODE=sql
COCKROACH_MCP_ENDPOINT=REPLACE_ME
COCKROACH_MCP_API_KEY=REPLACE_ME

# ── S3 policy documents ──────────────────────────────────────────────────────────────────
S3_POLICY_BUCKET=REPLACE_ME
# Tiny object the doctor calls GetObject on, since no policy document exists until Gate 4.
S3_DOCTOR_PROBE_KEY=_doctor-probe.json
# Uploaded at Gates 4 and 5. Defaults are fine unless you rename the objects.
S3_REFUND_POLICY_KEY=refund-policy.json
S3_DISPUTE_POLICY_KEY=dispute-policy.json
S3_GENERIC_POLICY_KEY=generic-policy.json
# Seconds a loaded policy document is cached before ETag revalidation.
POLICY_CACHE_TTL_SECONDS=300

# ── Entry point and web app ──────────────────────────────────────────────────────────────
# Gate 2 — the Function URL of the ticket-handler Lambda.
TICKET_HANDLER_FUNCTION_URL=REPLACE_ME
# Gate 8 — single shared password gating /queue. No RBAC by design.
WEB_QUEUE_PASSWORD=REPLACE_ME

# ── Runtime tunables ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
